# -*- mode: sh; sh-shell: bash -*-

export DIRENV_WARN_TIMEOUT=20s

# Disposable per-deployment SSH agent. The deployment's disposable keypair is
# held only by this agent (socket under the gitignored .ssh/), never by the
# user's default agent, so discarding the agent and the Vultr-side public key
# retires the credential completely.
mkdir -p "$PWD/.ssh"
export SSH_AUTH_SOCK="$PWD/.ssh/agent.sock"
ssh-add -l >/dev/null 2>&1
if [ $? -eq 2 ]; then
  # No agent behind the socket (stale or first run): start one.
  rm -f "$SSH_AUTH_SOCK"
  ssh-agent -a "$SSH_AUTH_SOCK" >/dev/null
fi
if [ -f "$PWD/.ssh/id_ed25519" ] && ! ssh-add -l >/dev/null 2>&1; then
  ssh-add "$PWD/.ssh/id_ed25519" >/dev/null 2>&1
fi

# This machine's ~/.ssh/config sets IdentitiesOnly yes and IdentityAgent none
# for every host except github.com, so OpenSSH (and therefore Ansible) would
# never offer the agent's key. Ansible's command-line options win over the
# host config, so point IdentityAgent at the disposable agent explicitly.
# This replaces the generated ssh_args, so it repeats them.
export ANSIBLE_SSH_ARGS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ForwardAgent=yes -o IdentitiesOnly=no -o IdentityAgent=$PWD/.ssh/agent.sock"

eval "$(devenv direnvrc)"

use devenv 2>/dev/null

# Safe to commit: every credential lives in the gitignored .envrc.private.
# Missing credentials must not prevent credential-free builds or safe dry runs.
# Run `direnv allow` once after the toolchain is installed.
#
# Never export COLORS_PAR_PROFILE. It identifies this deployment and must come
# only from colors.yml.
source_env_if_exists .envrc.private
